# SkinSense — Environment Variables
# ────────────────────────────────────────────────
MOCK_MODE=false

# ── MongoDB ───────────────────────────────────────────────────
MONGO_URL=
DB_NAME=GixyDB

# ── JWT Secrets ───────────────────────────────────────────────
SECRET_KEY=
REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Email / SMTP ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@gixy.app

# ── HuggingFace ───────────────────────────────────────────────
HF_TOKEN=

# ── Apple Sign-In ─────────────────────────────────────────────
APPLE_BUNDLE_ID=

# ── RevenueCat ────────────────────────────────────────────────
REVENUECAT_PROJECT_ID=
REVENUECAT_V2_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
RC_ENTITLEMENT_ID=gixy Pro


#── Admin Login ────────────────────────────────────────────────
ADMIN_CREATION_SECRET=


# ╔══════════════════════════════════════════════════════════════╗
# ║  LLM BACKEND                                                 ║
# ╚══════════════════════════════════════════════════════════════╝

# ── OPTION A: Local dev — Qwen2.5 VL 7B in LM Studio ─────────
USE_LOCAL_LLM=true
LM_STUDIO_BASE_URL=http://10.10.20.46:1234/v1
LM_STUDIO_MODEL=llama-3.2-3b-instruct
LM_STUDIO_VISION=false

# OPTION B: Production - Anthropic
# USE_LOCAL_LLM=false
# LM_STUDIO_VISION=false
# ANTHROPIC_API_KEY=


#------------SUPABASE CONFIGURATION----------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=